        "jsCode": "// Toma las filas del carrito de este cliente y las ordena de mayor a menor\n// numero de fila, para poder borrarlas sin que los indices se desplacen.\nconst rows = $('obtener carrito final').all()\n  .map(i => i.json)\n  .filter(r => r && r.row_number);\nrows.sort((a, b) => Number(b.row_number) - Number(a.row_number));\nreturn rows.map(r => ({ json: { row_number: Number(r.row_number) } }));"
      },
